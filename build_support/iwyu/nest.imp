# Mapping file for include-what-you-use (IWYU), used by
# build_support/check_iwyu.sh. See
# https://github.com/include-what-you-use/include-what-you-use/blob/master/docs/IWYUMappings.md
[
  # NEST code uses Boost sorting and the iterator/tuple machinery only
  # through the wrappers in libnestutil.
  { "include": ["@<boost/sort/.*>", "private", "\"sort.h\"", "public"] },
  { "include": ["@<boost/iterator/.*>", "private", "\"iterator_pair.h\"", "public"] },
  { "include": ["@<boost/tuple/.*>", "private", "\"iterator_pair.h\"", "public"] },
  # With GCC 15's standard library, IWYU 0.23 alternates between suggesting
  # <format> and <vector> for std::vector, and <iterator> and <utility> for
  # std::pair. Pin both symbols to the header that defines them.
  { "symbol": ["std::vector", "private", "<vector>", "public"] },
  { "symbol": ["std::pair", "private", "<utility>", "public"] },
  # Random123 configuration macros (R123_USE_...) come with the generator headers.
  { "include": ["@\"Random123/features/.*\"", "private", "\"Random123/philox.h\"", "public"] },
  # Boost.Math internals that leak out of tgamma_lower(); iaf_bw_2001.cpp
  # includes them, inside #ifdef HAVE_BOOST, through gamma.hpp only.
  { "include": ["@<boost/math/policies/.*>", "private", "<boost/math/special_functions/gamma.hpp>", "public"] },
  { "include": ["@<boost/math/tools/.*>", "private", "<boost/math/special_functions/gamma.hpp>", "public"] },
  { "include": ["<boost/math/special_functions/expm1.hpp>", "private", "<boost/math/special_functions/gamma.hpp>", "public"] },
  { "include": ["<boost/math/special_functions/sign.hpp>", "private", "<boost/math/special_functions/gamma.hpp>", "public"] },
]
