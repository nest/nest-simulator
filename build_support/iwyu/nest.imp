# Mapping file for include-what-you-use (IWYU), used by
# build_support/check_iwyu.sh. See
# https://github.com/include-what-you-use/include-what-you-use/blob/master/docs/IWYUMappings.md
[
  # NEST code uses Boost sorting and the iterator/tuple machinery only
  # through the wrappers in libnestutil.
  { "include": ["@<boost/sort/.*>", "private", "\"sort.h\"", "public"] },
  { "include": ["@<boost/iterator/.*>", "private", "\"iterator_pair.h\"", "public"] },
  { "include": ["@<boost/tuple/.*>", "private", "\"iterator_pair.h\"", "public"] },
]
